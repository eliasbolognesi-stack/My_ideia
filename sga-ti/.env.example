# =============================================================================
# SGA-TI — modelo de configuração
#
# Copie para .env e preencha. Este arquivo é versionado de propósito e NÃO deve
# conter nenhum segredo de verdade: ele existe para documentar o que existe.
# O .env preenchido é ignorado pelo git.
#
#     cp .env.example .env
#
# Em produção, prefira passar estas variáveis pelo systemd (EnvironmentFile)
# em vez de deixar um .env legível na pasta do aplicativo.
# =============================================================================

# Liga as checagens estritas de produção: o servidor se RECUSA a subir com
# combinação perigosa (webhook legado, escuta externa sem HTTPS). Deixe em
# "production" no servidor e vazio na sua máquina.
NODE_ENV=production


# -----------------------------------------------------------------------------
# OBRIGATÓRIAS EM PRODUÇÃO — errar qualquer uma destas tem consequência
# -----------------------------------------------------------------------------

# Uma chave por origem que envia eventos, no formato chave:email-do-autor.
# A CHAVE define quem é o autor do evento — o corpo da requisição não pode
# declarar outra pessoa. Gere cada uma com: openssl rand -hex 32
SGA_TI_WEBHOOK_KEYS=troque-esta-chave:estoque@empresa.com

# Senha do administrador criado no primeiro boot. Se ficar vazia, uma senha
# aleatória é gerada e impressa UMA ÚNICA VEZ no log de inicialização.
SGA_TI_ADMIN_SENHA=

# Ligue quando o sistema estiver atrás de um proxy reverso (nginx/Caddy).
# Sem proxy na frente, deixe desligado: o cliente forjaria o próprio endereço
# e escaparia do limite de tentativas.
SGA_TI_ATRAS_PROXY=1

# Ligue quando o acesso for por HTTPS. Envia o cabeçalho que obriga o navegador
# a usar conexão segura nas próximas visitas.
SGA_TI_FORCAR_HTTPS=1

# Domínios aceitos quando a evidência de descarte for um link. Vazio = qualquer
# domínio em https. Preencha com o domínio onde ficam os termos de baixa.
SGA_TI_DOMINIOS_EVIDENCIA=empresa.com

# Contato do encarregado pelos dados (DPO), exigido pela LGPD.
# Preencha também em public/privacidade.html.
SGA_TI_CONTATO_DPO=dpo@empresa.com


# -----------------------------------------------------------------------------
# REDE
# -----------------------------------------------------------------------------

PORT=3000

# Interface de escuta. MANTENHA em 127.0.0.1 e coloque um proxy reverso com
# TLS na frente. 0.0.0.0 expõe o sistema direto na rede, sem criptografia.
SGA_TI_HOST=127.0.0.1


# -----------------------------------------------------------------------------
# ARQUIVOS
# -----------------------------------------------------------------------------

# Caminho do banco. A pasta é criada se não existir.
SGA_TI_DB=/var/lib/sga-ti/sga-ti.db

# Registro de eventos de segurança, separado do banco.
SGA_TI_LOG_SEGURANCA=/var/lib/sga-ti/seguranca.log

# Rotação do registro: arquivo novo ao passar do tamanho, mantendo os últimos.
SGA_TI_LOG_TAMANHO_MB=5
SGA_TI_LOG_ARQUIVOS=5

# Quantos dias de cópias de segurança manter na pasta de destino.
SGA_TI_BACKUP_MANTER_DIAS=30


# -----------------------------------------------------------------------------
# COMPORTAMENTO
# -----------------------------------------------------------------------------

# Entre aspas porque tem espaço: o systemd aceitaria sem elas, mas quem
# testar com `source este-arquivo` no terminal veria "da: command not found".
SGA_TI_EMPRESA="Nome da Empresa"

# Validade da sessão de login, em horas.
SGA_TI_SESSAO_HORAS=12

# Prazo de guarda antes da anonimização dos dados pessoais (LGPD).
SGA_TI_PRAZO_RETENCAO_ANOS=5

# Exige aprovação humana para TODO descarte, não só o de equipamento em uso.
SGA_TI_APROVACAO_TODO_DESCARTE=0

# Responde 503 em tudo, sem derrubar o processo nem tocar no banco.
SGA_TI_MANUTENCAO=0


# -----------------------------------------------------------------------------
# LIMITES DE USO
# -----------------------------------------------------------------------------

# Tentativas de login SEM SUCESSO por origem, a cada 10 minutos.
# Entrar corretamente não consome o limite e zera a contagem.
SGA_TI_LIMITE_LOGIN=20

SGA_TI_LIMITE_EVENTOS=60
SGA_TI_LIMITE_WEBHOOK=120

# Tamanho máximo de cada campo de texto recebido.
SGA_TI_TAMANHO_CAMPO=2000


# -----------------------------------------------------------------------------
# OBSERVABILIDADE (Langfuse) — opcional, desligado por padrão
#
# Mostra num painel o caminho de cada registro: mensagem recebida no n8n →
# decisão da IA → gravação aqui, num rastro só. Sem as três variáveis abaixo, o
# sistema não faz nenhuma chamada. Passo a passo em deploy/langfuse.md.
# -----------------------------------------------------------------------------

# Endereço do SEU Langfuse. Atenção à porta: o Langfuse auto-hospedado usa a
# 3000 por padrão, a mesma do SGA-TI — suba um dos dois em outra.
# SGA_TI_LANGFUSE_URL=http://localhost:3001

# Chaves do projeto no Langfuse (Settings → API Keys).
# SGA_TI_LANGFUSE_CHAVE_PUBLICA=pk-lf-...
# SGA_TI_LANGFUSE_CHAVE_SECRETA=sk-lf-...

# O que sai daqui:
#   metadados (padrão) — nomes dos campos, contagens, resultado e duração.
#                        Nunca nome, e-mail ou matrícula de ninguém.
#   completo           — o conteúdo dos eventos vai junto. Útil para depurar o
#                        agente, mas passa a enviar DADO PESSOAL: só com
#                        Langfuse próprio. Mandar para um serviço em nuvem é
#                        transferência de dado pessoal a terceiro (LGPD).
SGA_TI_OBS_CONTEUDO=metadados


# -----------------------------------------------------------------------------
# LEGADO — não use em instalação nova
# -----------------------------------------------------------------------------

# Chave única em que o autor vinha declarado no corpo da requisição. Qualquer
# um com a chave podia registrar evento em nome de outra pessoa. Em produção o
# servidor se recusa a subir com esta opção.
# SGA_TI_WEBHOOK_KEY=
